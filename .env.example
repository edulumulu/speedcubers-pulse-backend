# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://speedcubers:speedcubers@localhost:5434/speedcubers_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Agora.io (Phase 4 video)
# Backend-only credentials used to issue RTC tokens from POST /api/v1/video/token.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
FREE_VIDEO_MINUTES_PER_MONTH=60
FREE_VIDEO_GLOBAL_MINUTES_PER_MONTH=8000

# WCA API
WCA_API_BASE_URL=https://www.worldcubeassociation.org/api/v0

# CORS
# Comma-separated frontend origins. Required in production; never use * in production.
ALLOWED_ORIGINS=http://localhost:5173

# Production security
# Set when frontend/backend use a shared parent domain, for example .speedcuberspulse.com.
REFRESH_COOKIE_DOMAIN=
# Allowed values: strict, lax, none. Defaults to lax locally and none in production.
REFRESH_COOKIE_SAMESITE=
# Number of trusted reverse proxies. Defaults to 1 in production, false locally.
TRUST_PROXY_HOPS=
# Keep empty. Set to true only for a controlled one-off production seed.
ALLOW_PRODUCTION_SEED=
