{
  "name": "speedcubers-pulse-backend",
  "version": "0.1.0",
  "description": "Backend for SpeedCubers Pulse — Node.js + Express",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/unit --forceExit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/integration --passWithNoTests --forceExit --runInBand --setupFiles=./tests/integration/setup.js",
    "test:e2e": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/e2e",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --forceExit --runInBand --setupFiles=./tests/integration/setup.js",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:undo": "node scripts/migrate.js down",
    "db:seed": "node scripts/seed.js",
    "db:seed:undo": "node scripts/seed.js down",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "db:reset": "npm run db:seed:undo && npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed",
    "db:migrate:undo:all": "node scripts/migrate.js down:all"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "redis": "^6.0.0",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@sequelize/cli": "^7.0.0-alpha.43",
    "eslint": "^9.6.0",
    "globals": "^15.8.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "umzug": "^3.8.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "extensionsToTreatAsEsm": [],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 75,
        "lines": 80,
        "statements": 80
      },
      "./src/application/services/AuthService.js": {
        "branches": 90,
        "functions": 90,
        "lines": 85,
        "statements": 85
      }
    },
    "setupFilesAfterEnv": [],
    "collectCoverageFrom": [
      "src/application/**/*.js",
      "src/domain/entities/**/*.js",
      "src/presentation/controllers/**/*.js",
      "src/presentation/middleware/**/*.js",
      "src/presentation/validators/**/*.js"
    ]
  }
}
